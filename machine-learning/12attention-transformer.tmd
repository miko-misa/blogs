```typst {scope=preamble}
#set page(fill: white, margin: 4pt)
#set text(font: ("New Computer Modern", "Noto Sans JP"))

#import "@preview/cetz:0.3.4"

// ============================================================
// CeTZ reusable block macros
//
// Provides:
// - rounded-block
// - trapezoid-block
// - rounded trapezoid support
// - center-content support
// - inner-draw callback support
// - custom anchors for trapezoid blocks
//
// Coordinate convention:
// - lt = left-top coordinate
// - rb = right-bottom coordinate
// - Intended mainly for numeric CeTZ canvas coordinates.
// ============================================================


// ============================================================
// 0. Basic point utilities
// ============================================================

#let _side-inset(length, shrink) = {
  // If shrink is a ratio, e.g. 30%,
  // the entire target side is shortened by 30%.
  // So each end moves inward by 15%.
  if type(shrink) == ratio {
    length * float(shrink) / 2
  } else {
    // If shrink is numeric, each end moves inward by this value.
    shrink
  }
}

#let _mid(a, b) = {
  (
    (a.at(0) + b.at(0)) / 2,
    (a.at(1) + b.at(1)) / 2,
  )
}

#let _pt-add(a, b) = {
  (a.at(0) + b.at(0), a.at(1) + b.at(1))
}

#let _pt-sub(a, b) = {
  (a.at(0) - b.at(0), a.at(1) - b.at(1))
}

#let _pt-scale(a, s) = {
  (a.at(0) * s, a.at(1) * s)
}

#let _pt-dist(a, b) = {
  let dx = a.at(0) - b.at(0)
  let dy = a.at(1) - b.at(1)
  calc.sqrt(dx * dx + dy * dy)
}

#let _pt-unit(a) = {
  let d = calc.sqrt(a.at(0) * a.at(0) + a.at(1) * a.at(1))
  if d == 0 {
    (0, 0)
  } else {
    (a.at(0) / d, a.at(1) / d)
  }
}


// ============================================================
// 1. Rectangle anchor helpers
// ============================================================

#let rect-anchor-pos(lt, rb, anchor-name) = {
  let lx = lt.at(0)
  let ty = lt.at(1)
  let rx = rb.at(0)
  let by = rb.at(1)
  
  let center = ((lx + rx) / 2, (ty + by) / 2)
  
  if anchor-name == "center" or anchor-name == "default" {
    center
  } else if anchor-name == "north" {
    ((lx + rx) / 2, ty)
  } else if anchor-name == "east" {
    (rx, (ty + by) / 2)
  } else if anchor-name == "south" {
    ((lx + rx) / 2, by)
  } else if anchor-name == "west" {
    (lx, (ty + by) / 2)
  } else if anchor-name == "north-east" {
    (rx, ty)
  } else if anchor-name == "south-east" {
    (rx, by)
  } else if anchor-name == "south-west" {
    (lx, by)
  } else if anchor-name == "north-west" {
    (lx, ty)
  } else {
    panic("unknown rect anchor: " + anchor-name)
  }
}

#let rect-anchors(lt, rb) = {
  (
    default: rect-anchor-pos(lt, rb, "center"),
    center: rect-anchor-pos(lt, rb, "center"),
    north: rect-anchor-pos(lt, rb, "north"),
    east: rect-anchor-pos(lt, rb, "east"),
    south: rect-anchor-pos(lt, rb, "south"),
    west: rect-anchor-pos(lt, rb, "west"),
    north-east: rect-anchor-pos(lt, rb, "north-east"),
    south-east: rect-anchor-pos(lt, rb, "south-east"),
    south-west: rect-anchor-pos(lt, rb, "south-west"),
    north-west: rect-anchor-pos(lt, rb, "north-west"),
  )
}


// ============================================================
// 2. Rounded rectangle block
// ============================================================

#let rounded-block(
  lt,
  rb,
  title,
  name: none,
  block-style: (
    fill: rgb("#f8fafc"),
    stroke: rgb("#334155") + 0.8pt,
    radius: 8pt,
  ),
  title-inset: 0.16,
  title-angle: 0deg,
  title-style: (
    anchor: "north",
    padding: (x: 4pt, y: 1pt),
    frame: none,
    wrap: text.with(
      size: 8pt,
      weight: "semibold",
      fill: rgb("#0f172a"),
    ),
  ),
  center-content: none,
  center-style: (
    anchor: "center",
    padding: (x: 2pt, y: 1pt),
    frame: none,
    wrap: text.with(
      size: 9pt,
      fill: rgb("#0f172a"),
    ),
  ),
  // Callback for drawing inside the same CeTZ canvas.
  // Receives an anchor dictionary:
  // a.center, a.north, a.east, a.south, a.west,
  // a.at("north-east"), etc.
  inner-draw: none,
) = {
  import cetz.draw: *
  
  let lx = lt.at(0)
  let ty = lt.at(1)
  let rx = rb.at(0)
  let by = rb.at(1)
  
  let bl = (lx, by)
  let tr = (rx, ty)
  
  let anchors = rect-anchors(lt, rb)
  
  rect(
    bl,
    tr,
    name: name,
    ..block-style,
  )
  
  if inner-draw != none {
    inner-draw(anchors)
  }
  
  if center-content != none {
    content(
      anchors.center,
      center-content,
      ..center-style,
    )
  }
  
  if title != none {
    content(
      ((lx + rx) / 2, ty - title-inset),
      title,
      angle: title-angle,
      ..title-style,
    )
  }
}


// ============================================================
// 3. Trapezoid geometry
// ============================================================

#let trapezoid-points(
  lt,
  rb,
  side: "top",
  shrink: 30%,
) = {
  let lx = lt.at(0)
  let ty = lt.at(1)
  let rx = rb.at(0)
  let by = rb.at(1)
  
  let w = rx - lx
  let h = ty - by
  
  if side == "top" or side == "north" or side == "up" {
    let d = _side-inset(w, shrink)
    (
      (lx, by),
      (rx, by),
      (rx - d, ty),
      (lx + d, ty),
    )
  } else if side == "right" or side == "east" {
    let d = _side-inset(h, shrink)
    (
      (lx, by),
      (rx, by + d),
      (rx, ty - d),
      (lx, ty),
    )
  } else if side == "bottom" or side == "south" or side == "down" {
    let d = _side-inset(w, shrink)
    (
      (lx + d, by),
      (rx - d, by),
      (rx, ty),
      (lx, ty),
    )
  } else if side == "left" or side == "west" {
    let d = _side-inset(h, shrink)
    (
      (lx, by + d),
      (rx, by),
      (rx, ty),
      (lx, ty - d),
    )
  } else {
    panic("unknown side: " + side)
  }
}

#let trapezoid-anchor-pos(pts, anchor-name) = {
  let p0 = pts.at(0)
  let p1 = pts.at(1)
  let p2 = pts.at(2)
  let p3 = pts.at(3)
  
  let center = (
    (p0.at(0) + p1.at(0) + p2.at(0) + p3.at(0)) / 4,
    (p0.at(1) + p1.at(1) + p2.at(1) + p3.at(1)) / 4,
  )
  
  if anchor-name == "center" or anchor-name == "default" {
    center
  } else if anchor-name == "north" {
    _mid(p2, p3)
  } else if anchor-name == "east" {
    _mid(p1, p2)
  } else if anchor-name == "south" {
    _mid(p0, p1)
  } else if anchor-name == "west" {
    _mid(p3, p0)
  } else if anchor-name == "north-east" {
    p2
  } else if anchor-name == "south-east" {
    p1
  } else if anchor-name == "south-west" {
    p0
  } else if anchor-name == "north-west" {
    p3
  } else {
    panic("unknown trapezoid anchor: " + anchor-name)
  }
}

#let trapezoid-anchors(pts) = {
  (
    default: trapezoid-anchor-pos(pts, "center"),
    center: trapezoid-anchor-pos(pts, "center"),
    north: trapezoid-anchor-pos(pts, "north"),
    east: trapezoid-anchor-pos(pts, "east"),
    south: trapezoid-anchor-pos(pts, "south"),
    west: trapezoid-anchor-pos(pts, "west"),
    north-east: trapezoid-anchor-pos(pts, "north-east"),
    south-east: trapezoid-anchor-pos(pts, "south-east"),
    south-west: trapezoid-anchor-pos(pts, "south-west"),
    north-west: trapezoid-anchor-pos(pts, "north-west"),
  )
}


// ============================================================
// 4. Rounded polygon path
// ============================================================

#let _corner-radius-value(lt, rb, corner-radius) = {
  let lx = lt.at(0)
  let ty = lt.at(1)
  let rx = rb.at(0)
  let by = rb.at(1)
  
  let w = calc.abs(rx - lx)
  let h = calc.abs(ty - by)
  
  if type(corner-radius) == ratio {
    calc.min(w, h) * float(corner-radius)
  } else {
    corner-radius
  }
}

#let rounded-polygon-data(pts, radius) = {
  let n = pts.len()
  let result = ()
  
  for i in range(0, n) {
    let prev = pts.at(if i == 0 { n - 1 } else { i - 1 })
    let cur = pts.at(i)
    let next = pts.at(if i == n - 1 { 0 } else { i + 1 })
    
    let len-prev = _pt-dist(cur, prev)
    let len-next = _pt-dist(cur, next)
    
    let r = calc.min(
      radius,
      calc.min(len-prev / 2, len-next / 2),
    )
    
    let dir-prev = _pt-unit(_pt-sub(prev, cur))
    let dir-next = _pt-unit(_pt-sub(next, cur))
    
    let pin = _pt-add(cur, _pt-scale(dir-prev, r))
    let pout = _pt-add(cur, _pt-scale(dir-next, r))
    
    result.push((
      corner: cur,
      pin: pin,
      pout: pout,
    ))
  }
  
  result
}

#let rounded-polygon-path(
  pts,
  radius,
  style,
) = {
  import cetz.draw: *
  
  if radius <= 0 {
    line(
      ..pts,
      close: true,
      ..style,
    )
  } else {
    let data = rounded-polygon-data(pts, radius)
    let n = data.len()
    
    let commands = ()
    
    commands.push(("M", data.at(0).at("pout")))
    
    for i in range(1, n) {
      let d = data.at(i)
      commands.push(("L", d.at("pin")))
      commands.push(("Q", d.at("corner"), d.at("pout")))
    }
    
    let d0 = data.at(0)
    commands.push(("L", d0.at("pin")))
    commands.push(("Q", d0.at("corner"), d0.at("pout")))
    
    // In CeTZ 0.5.2, lowercase "z" closes the subpath as closed.
    commands.push(("z",))
    
    svg-path(
      ..commands,
      ..style,
    )
  }
}


// ============================================================
// 5. Trapezoid block
// ============================================================

#let _draw-trapezoid-body(
  pts,
  title,
  title-pos,
  block-style,
  title-style,
  corner-radius,
  center-content,
  center-style,
  inner-draw,
) = {
  import cetz.draw: *
  
  let anchors = trapezoid-anchors(pts)
  
  rounded-polygon-path(
    pts,
    corner-radius,
    block-style,
  )
  
  if inner-draw != none {
    inner-draw(anchors)
  }
  
  if center-content != none {
    content(
      anchors.center,
      center-content,
      ..center-style,
    )
  }
  
  if title != none {
    content(
      title-pos,
      title,
      ..title-style,
    )
  }
}

#let trapezoid-block(
  lt,
  rb,
  title,
  name: none,
  // Which side is shrunk toward its own center.
  // Available values:
  // - "top", "north", "up"
  // - "right", "east"
  // - "bottom", "south", "down"
  // - "left", "west"
  side: "top",
  // ratio:
  //   shrink: 30% means the target side becomes 30% shorter in total.
  // number:
  //   shrink: 0.3 means each endpoint moves inward by 0.3.
  shrink: 30%,
  // 0 means sharp trapezoid.
  // number means canvas-unit corner radius.
  // ratio means ratio of the shorter side of the bounding rectangle.
  corner-radius: 0,
  block-style: (
    fill: rgb("#f8fafc"),
    stroke: rgb("#334155") + 0.8pt,
  ),
  title-inset: 0.16,
  title-style: (
    anchor: "north",
    padding: (x: 4pt, y: 1pt),
    frame: none,
    wrap: text.with(
      size: 8pt,
      weight: "semibold",
      fill: rgb("#0f172a"),
    ),
  ),
  center-content: none,
  center-style: (
    anchor: "center",
    padding: (x: 2pt, y: 1pt),
    frame: none,
    wrap: text.with(
      size: 9pt,
      fill: rgb("#0f172a"),
    ),
  ),
  // Callback for drawing inside the same CeTZ canvas.
  // Receives an anchor dictionary:
  // a.center, a.north, a.east, a.south, a.west,
  // a.at("north-east"), etc.
  inner-draw: none,
) = {
  import cetz.draw: *
  
  let lx = lt.at(0)
  let ty = lt.at(1)
  let rx = rb.at(0)
  
  let pts = trapezoid-points(
    lt,
    rb,
    side: side,
    shrink: shrink,
  )
  
  let anchors = trapezoid-anchors(pts)
  
  let title-pos = ((lx + rx) / 2, ty - title-inset)
  
  let resolved-radius = _corner-radius-value(
    lt,
    rb,
    corner-radius,
  )
  
  if name == none {
    _draw-trapezoid-body(
      pts,
      title,
      title-pos,
      block-style,
      title-style,
      resolved-radius,
      center-content,
      center-style,
      inner-draw,
    )
  } else {
    group(name: name, {
      _draw-trapezoid-body(
        pts,
        title,
        title-pos,
        block-style,
        title-style,
        resolved-radius,
        center-content,
        center-style,
        inner-draw,
      )
      
      anchor("default", anchors.default)
      anchor("center", anchors.center)
      
      anchor("north", anchors.north)
      anchor("east", anchors.east)
      anchor("south", anchors.south)
      anchor("west", anchors.west)
      
      anchor("north-east", anchors.at("north-east"))
      anchor("south-east", anchors.at("south-east"))
      anchor("south-west", anchors.at("south-west"))
      anchor("north-west", anchors.at("north-west"))
    })
  }
}


#let route-step(start, end, turn: 50%, dir: "h") = {
  // turnに `(1.5, 0)` のような配列が渡された場合は、startからの相対座標として扱う
  // それ以外（`50%` など）の場合は、startとendの中間点として扱う
  let turn-pt = if type(turn) == array {
    (rel: turn, to: start)
  } else {
    (start, turn, end)
  }
  
  if dir == "h" {
    // 横 → 縦 → 横 （デフォルト）
    (
      start,
      (start, "-|", turn-pt),
      (end, "-|", turn-pt),
      end,
    )
  } else if dir == "v" {
    // 縦 → 横 → 縦
    (
      start,
      (start, "|-", turn-pt),
      (end, "|-", turn-pt),
      end,
    )
  }
}

#import "@preview/cetz:0.3.4" as cetz

#let tile-id(name, row, col) = {
  name + "-" + str(row) + "-" + str(col)
}

#let normalize-gap(gap) = {
  if type(gap) == dictionary {
    (
      x: gap.at("x", default: 0),
      y: gap.at("y", default: 0),
    )
  } else {
    (
      x: gap.at(0),
      y: gap.at(1),
    )
  }
}

#let gap-value(spec, i) = {
  if i < 0 {
    0
  } else if type(spec) == function {
    let result = spec(i)
    if result == none { 0 } else { result }
  } else if type(spec) == array {
    spec.at(i, default: 0)
  } else {
    spec
  }
}

#let gap-sum-before(spec, n) = {
  let result = 0
  if n > 0 {
    for i in range(n) {
      result += gap-value(spec, i)
    }
  }
  result
}

#let gap-sum-from(spec, start, count) = {
  let result = 0
  if count > 0 {
    for i in range(start, start + count) {
      result += gap-value(spec, i)
    }
  }
  result
}

#let merge-span(merge) = {
  if "span" in merge {
    merge.span
  } else {
    let axis = merge.at("axis", default: "x")
    let len = merge.at("len", default: 1)

    if axis == "x" {
      (len, 1)
    } else {
      (1, len)
    }
  }
}

#let tiled-rects(
  name,
  left-top,
  cell,
  count,
  gap: (0, 0),
  style: (:),
  overrides: (:),
  merges: (),
) = {
  import cetz.draw: rect

  let x0 = left-top.at(0)
  let y0 = left-top.at(1)

  let w = cell.at(0)
  let h = cell.at(1)

  let cols = count.at(0)
  let rows = count.at(1)

  let gaps = normalize-gap(gap)
  let gx = gaps.x
  let gy = gaps.y

  let total-w = cols * w + gap-sum-before(gx, cols - 1)
  let total-h = rows * h + gap-sum-before(gy, rows - 1)

  rect(
    (x0, y0 - total-h),
    (rel: (total-w, total-h)),
    name: name,
    fill: none,
    stroke: none,
  )

  let cell-left(col) = {
    x0 + col * w + gap-sum-before(gx, col)
  }

  let cell-top(row) = {
    y0 - row * h - gap-sum-before(gy, row)
  }

  let merge-start(row, col) = {
    let result = none

    for merge in merges {
      let start = merge.at("start")
      let sr = start.at(0)
      let sc = start.at(1)

      if row == sr and col == sc {
        result = merge
      }
    }

    result
  }

  let in-merge(row, col) = {
    let result = false

    for merge in merges {
      let start = merge.at("start")
      let sr = start.at(0)
      let sc = start.at(1)

      let span = merge-span(merge)
      let span-cols = span.at(0)
      let span-rows = span.at(1)

      if row >= sr and row < sr + span-rows and col >= sc and col < sc + span-cols {
        result = true
      }
    }

    result
  }

  let resolve-override(info, id, short-id) = {
    if type(overrides) == function {
      let result = overrides(info)
      if result == none { (:) } else { result }
    } else {
      overrides.at(
        id,
        default: overrides.at(short-id, default: (:)),
      )
    }
  }

  for row in range(rows) {
    for col in range(cols) {
      let px = cell-left(col)
      let py = cell-top(row)

      let merge = merge-start(row, col)

      if merge != none {
        let span = merge-span(merge)
        let span-cols = span.at(0)
        let span-rows = span.at(1)

        let tag = merge.at("id", default: none)
        let merge-style = merge.at("style", default: (:))

        let mw = span-cols * w + gap-sum-from(gx, col, span-cols - 1)
        let mh = span-rows * h + gap-sum-from(gy, row, span-rows - 1)

        let id = if tag == none {
          tile-id(name, row, col)
        } else {
          name + "-" + tag
        }

        let short-id = if tag == none {
          str(row) + "-" + str(col)
        } else {
          tag
        }

        let info = (
          kind: "merge",
          row: row,
          col: col,
          x: col,
          y: row,
          span: span,
          span-cols: span-cols,
          span-rows: span-rows,
          name: id,
          left-top: (px, py),
          left-bottom: (px, py - mh),
          right-top: (px + mw, py),
          right-bottom: (px + mw, py - mh),
          center: (px + mw / 2, py - mh / 2),
        )

        let local-style = resolve-override(info, id, short-id)

        rect(
          info.left-bottom,
          info.right-top,
          name: id,
          ..(style + merge-style + local-style),
        )
      } else if not in-merge(row, col) {
        let id = tile-id(name, row, col)
        let short-id = str(row) + "-" + str(col)

        let info = (
          kind: "cell",
          row: row,
          col: col,
          x: col,
          y: row,
          span: (1, 1),
          span-cols: 1,
          span-rows: 1,
          name: id,
          left-top: (px, py),
          left-bottom: (px, py - h),
          right-top: (px + w, py),
          right-bottom: (px + w, py - h),
          center: (px + w / 2, py - h / 2),
        )

        let local-style = resolve-override(info, id, short-id)

        rect(
          info.left-bottom,
          info.right-top,
          name: id,
          ..(style + local-style),
        )
      }
    }
  }
}

// lab の figures.typ に合わせた配色
#let c-blue = rgb("1d5fbf")
#let c-blue-l = rgb("eff6ff")
#let c-teal = rgb("0f766e")
#let c-teal-l = rgb("ecfeff")
#let c-green = rgb("16a34a")
#let c-green-l = rgb("f0fdf4")
#let c-red = rgb("dd5a5a")
#let c-red-l = rgb("ffe5e5")
#let c-purple = rgb("7c3aed")
#let c-purple-l = rgb("faf5ff")
#let c-orange = rgb("eb7507")
#let c-orange-l = rgb("fff7ed")
#let c-gray = rgb("a1aab6")
#let c-gray-l = rgb("f8fafc")

#let bs(stroke-c, fill-c) = (fill: fill-c, stroke: stroke-c + 1pt, radius: 5pt)
#let lbl(s) = text(size: 8pt, weight: "semibold", fill: black, s)
#let arw = (mark: (end: "triangle", fill: black, scale: 0.7), stroke: black + 0.9pt)
```

# AttentionとTransformer

自然言語をはじめとした系列データを処理するニューラルネットワークとして、RNNやLSTMが広く使われてきた。しかし、これらのモデルでは情報を系列に沿って順番に伝える必要がある。例えば、$bold(x)_1, bold(x)_2,dots.c,bold(x)_N$という系列において、$bold(x)_1$の情報を$bold(x)_N$の処理に活かすためには、中間の隠れ状態を通して情報を伝播させなければならない。そのため、要素同士が遠く離れるほど、その関連性を学習することが難しくなる。また、系列を順番に処理する必要があるため、計算を並列化しにくいという問題もある。

これに対してAttentionでは、情報を隠れ状態によって順番に伝えるのではなく、系列中の各要素を直接参照し、その中から現在の処理に重要な情報を選択する。これにより、系列中で離れた要素の情報も、途中の隠れ状態を何度も経由せずに利用できる。つまり、$bold(x)_N$の処理において、$bold(x)_1, dots.c, bold(x)_(N-1)$の情報を直接参照し、重みをつけて集約することができる。これにより、長期的な依存関係を学習しやすくなる。

Transformerは、このAttentionを系列処理の中心に据え、RNNのような再帰構造を取り除いたモデルである。系列全体の関係をまとめて計算することで、長期的な依存関係を扱いやすくすると同時に、学習時の並列計算を可能にした。以降では、Transformerで使われるAttentionの仕組みを具体的に説明する。


# Attention
まず、系列データを以下のように表す。
$$
bold(X) = mat(bold(x)_1^top; bold(x)_2^top; dots.v; bold(x)_N^top) in RR^(N times d_"in")
$$

$bold(x)_k in RR^(d_"in")$は系列の各要素を表すベクトルであり、$d_"in"$はモデルの隠れ状態の次元数である。ここでの目標は、$k$番目の要素$bold(x)_k$に対応する出力$bold(y)_k$を次のようにすべての系列要素から集約して計算することである。
$$
bold(y)_k = sum_(j=1)^N w_(k,j) bold(f) (bold(x)_j)
$$

$bold(f)$は系列の各要素を変換する関数であり、$w_(k,j)$は$bold(x)_k$が$bold(x)_j$をどれだけ参照するかを表す重みである。すなわち、$w_(k,j)$が大きいほど、$bold(x)_j$の情報が$bold(y)_k$に強く反映される。Attentionでは$bold(f) (bold(x)_j)$を**バリュー**、$w_(k,j)$を**アテンション重み**と呼び、これは**クエリ**と**キー**の適合度にもとづいて計算される。以下、以下のように定義する。

- **クエリ**: $bold(q)_k = bold(W)_Q bold(x)_k in RR^(d_k)$
- **キー**: $bold(k)_j = bold(W)_K bold(x)_j in RR^(d_k)$
- **バリュー**: $bold(v)_j = bold(W)_V bold(x)_j in RR^(d_"out")$

これを元に書き下してみると、

$$
bold(y)_k ~ sum_(j=1)^N "sim"(bold(q)_k, bold(k)_j) bold(v)_j
$$

となる。ここで$"sim"(bold(q)_k, bold(k)_j)$はクエリとキーの類似度を表す関数である。さて、一般的に"sim"は内積で定義されることが多い。すなわち、$"sim"(bold(q)_k, bold(k)_j) = bold(q)_k^top bold(k)_j$である。これにより、クエリとキーの類似度が大きいほど、バリューの重みが大きくなる。また、以下に二つの工夫を追加する。

- 重み$w_(k,j)$は正規化される必要がある。つまり、$sum_(j=1)^N w_(k,j) = 1$である必要がある。そこで、ソフトマックス関数を用いて正規化する。すなわち、
$$
w_(k,j) = frac(exp(bold(q)_k^top bold(k)_j), sum_(l=1)^N exp(bold(q)_k^top bold(k)_l))
$$
- クエリとキーの内積は、ベクトルの次元数が大きくなると値が大きくなりやすい。これにより、ソフトマックス関数を通した際に勾配が小さくなり、学習が遅くなることがある。そこで、内積を$sqrt(d_k)$で割ることで、値のスケールを調整する。

以上より、Attentionの出力は以下のように計算される。
$$
bold(y)_k = sum_(j=1)^N w_(k,j) bold(v)_j = sum_(j=1)^N frac(exp((bold(q)_k^top bold(k)_j) / sqrt(d_k)), sum_(l=1)^N exp((bold(q)_k^top bold(k)_l) / sqrt(d_k))) bold(v)_j
$$

これは簡単な行列計算で表すことができる。まず、クエリ、キー、バリューをそれぞれ行列に集約する。
$$
bold(Q) = mat(bold(q)_1^top; bold(q)_2^top; dots.v; bold(q)_M^top) in RR^(M times d_k) quad bold(K) = mat(bold(k)_1^top; bold(k)_2^top; dots.v; bold(k)_N^top) in RR^(N times d_k) quad bold(V) = mat(bold(v)_1^top; bold(v)_2^top; dots.v; bold(v)_N^top) in RR^(N times d_v)
$$
すると、正規化する前の類似度行列は

$$
bold(Q) bold(K)^top = mat(bold(q)_1^top; bold(q)_2^top; dots.v; bold(q)_M^top) mat(bold(k)_1, bold(k)_2, dots.c, bold(k)_N) = mat(bold(q)_1^top bold(k)_1, bold(q)_1^top bold(k)_2, dots.h, bold(q)_1^top bold(k)_N; bold(q)_2^top bold(k)_1, bold(q)_2^top bold(k)_2, dots.h, bold(q)_2^top bold(k)_N; dots.v, dots.v, dots.down, dots.v; bold(q)_M^top bold(k)_1, bold(q)_M^top bold(k)_2, dots.h, bold(q)_M^top bold(k)_N) in RR^(M times N)
$$

となる。行列に対するソフトマックス関数は、一般的に各行ごとに正規化を行うことで決められているので、Attentionの出力は以下のようにまとめられる。
$$
"Attention"(bold(Q), bold(K), bold(V)) = "softmax"(frac(bold(Q) bold(K)^top, sqrt(d_k))) bold(V)
$$

```typst {render=svg caption="Scaled Dot-Product Attentionの計算手順（Vaswani et al., 2017 Figure 2左）"}
#cetz.canvas(length: 1cm, {
  import cetz.draw: *

  let cx = 1.5      // 中央列の中心
  let vx = 4.1      // V の列
  let w  = 3.0      // ブロックの幅
  let h  = 0.8      // ブロックの高さ

  let blk(y, label, sc, fc, right) = {
    rounded-block((0, y), (right, y - h), none,
      block-style: bs(sc, fc), center-content: lbl(label))
  }
  blk(0,    [MatMul],      c-purple, c-purple-l, 4.6)
  blk(-1.8, [SoftMax],     c-green,  c-green-l,  w)
  blk(-3.6, [Mask (opt.)], c-red,    c-red-l,    w)
  blk(-5.4, [Scale],       c-orange, c-orange-l, w)
  blk(-7.2, [MatMul],      c-purple, c-purple-l, w)

  // 中央列を下から上へ
  line((cx, -7.2), (cx, -6.2), ..arw)
  line((cx, -5.4), (cx, -4.4), ..arw)
  line((cx, -3.6), (cx, -2.6), ..arw)
  line((cx, -1.8), (cx, -0.8), ..arw)

  // 入力と出力
  line((0.75, -9.1), (0.75, -8.0), ..arw)
  line((2.25, -9.1), (2.25, -8.0), ..arw)
  line((vx,   -9.1), (vx,   -0.8), ..arw)
  line((2.3, 0), (2.3, 1.1), ..arw)

  content((0.75, -9.5), text(size: 9pt, $bold(Q)$))
  content((2.25, -9.5), text(size: 9pt, $bold(K)$))
  content((vx,   -9.5), text(size: 9pt, $bold(V)$))
})
```

ここでは、クエリ、キー、バリューは一つの同じ系列から生成される**Self-Attention**を説明してきた。この場合、これらは次のように計算される。
$$
bold(Q) = bold(X) bold(W)_Q quad bold(K) = bold(X) bold(W)_K quad bold(V) = bold(X) bold(W)_V
$$
ここではクエリとキーは対称的な関係を持っている。しかし、実際にはそうではない。クエリを別の系列データから生成するようにしてみよう。
$$
bold(Q) = bold(X)^((1)) bold(W)_Q in RR^(M times d_k) quad bold(K) = bold(X)^((2)) bold(W)_K in RR^(N times d_k) quad bold(V) = bold(X)^((2)) bold(W)_V in RR^(N times d_v)
$$
すると$bold(Q)bold(K)^top$は、クエリ側の系列$bold(x)_1^((1)), dots.c, bold(x)_M^((1))$と、キー側の系列$bold(x)_1^((2)), dots.c, bold(x)_N^((2))$の間の類似度を表す行列となる。これにより、1つの要素の出力は
$$
bold(y)_k = sum_(j=1)^N "sim"(bold(q)^((1))_k, bold(k)^((2))_j) bold(v)^((2))_j
$$
となる。ここではどちらの系列から来たのかを明示するために、クエリ側の系列には上付きの$(1)$、キー・バリュー側の系列には上付きの$(2)$を付けている。この式は出力に対応する位置のクエリをキーとの関連度を元にバリューで重み付けして集約することを意味している。いわば、クエリ系列をキー・バリュー系列に照らし合わせて処理することになる。これを**Cross-Attention**と呼ぶ。

# Transformer
**Transformer**は、RNNやCNNに頼らず、Attention機構を中心に系列を処理するエンコーダ・デコーダ型のモデルである。各ブロックは、Multi-Head Attention、位置ごとのFeed-Forward Network、Residual Connection、Layer Normalizationから構成される。 エンコーダは入力列から文脈表現を生成し、デコーダはその文脈と既に生成した出力を用いて次のトークンを予測する。

```typst {render=svg caption="Transformerのエンコーダ・デコーダ構造（Vaswani et al., 2017 Figure 1）"}
#cetz.canvas(length: 1cm, {
  import cetz.draw: *

  let ex = 1.5      // エンコーダ列の中心
  let dx = 8.0      // デコーダ列の中心
  let hw = 1.5      // ブロックの半幅
  let r  = 0.2      // 加算アイコンの半径

  let blk(cx, yt, yb, label, sc, fc) = {
    rounded-block((cx - hw, yt), (cx + hw, yb), none,
      block-style: bs(sc, fc), center-content: lbl(label))
  }
  // 残差の加算。この丸が Add にあたる
  let oplus(x, y) = {
    circle((x, y), radius: r, stroke: black + 0.9pt, fill: white)
    line((x - 0.1, y), (x + 0.1, y), stroke: black + 0.8pt)
    line((x, y - 0.1), (x, y + 0.1), stroke: black + 0.8pt)
  }
  // 本線から迂回して加算アイコンの横に入る
  let resid(cx, ytap, xd, yadd) = {
    let xin = if xd < cx { cx - r } else { cx + r }
    line((cx, ytap), (xd, ytap), (xd, yadd), (xin, yadd), ..arw)
  }

  // 外枠
  rounded-block((ex - 1.9, -5.4), (ex + 1.9, -13.9), none,
    block-style: (fill: c-gray-l, stroke: c-gray + 1pt, radius: 8pt))
  rounded-block((dx - 1.9, -1.2), (dx + 1.9, -13.9), none,
    block-style: (fill: c-gray-l, stroke: c-gray + 1pt, radius: 8pt))
  content((ex - 2.6, -9.6), text(size: 9pt)[$N times$])
  content((dx + 2.6, -7.5), text(size: 9pt)[$N times$])

  // エンコーダ（下から上へ）
  blk(ex, -12.2, -13.2, [Multi-Head\ Attention], c-orange, c-orange-l)
  oplus(ex, -11.4)
  blk(ex, -10.0, -10.6, [LayerNorm],             c-teal,   c-teal-l)
  blk(ex,  -8.2,  -9.2, [Feed\ Forward],         c-blue,   c-blue-l)
  oplus(ex, -7.4)
  blk(ex,  -6.0,  -6.6, [LayerNorm],             c-teal,   c-teal-l)

  // デコーダ（下から上へ）
  blk(dx, -12.0, -13.2, [Masked\ Multi-Head\ Attention], c-orange, c-orange-l)
  oplus(dx, -11.2)
  blk(dx,  -9.8, -10.4, [LayerNorm],                     c-teal,   c-teal-l)
  blk(dx,  -8.0,  -9.0, [Multi-Head\ Attention],         c-orange, c-orange-l)
  oplus(dx, -7.2)
  blk(dx,  -5.8,  -6.4, [LayerNorm],                     c-teal,   c-teal-l)
  blk(dx,  -4.0,  -5.0, [Feed\ Forward],                 c-blue,   c-blue-l)
  oplus(dx, -3.2)
  blk(dx,  -1.8,  -2.4, [LayerNorm],                     c-teal,   c-teal-l)

  // 出力側
  blk(dx,  0.0, -0.6, [Linear],  c-purple, c-purple-l)
  blk(dx,  1.2,  0.6, [Softmax], c-green,  c-green-l)

  // 本線（エンコーダ）
  line((ex, -14.4), (ex, -13.2), ..arw)
  line((ex, -12.2), (ex, -11.6), ..arw)
  line((ex, -11.2), (ex, -10.6), ..arw)
  line((ex, -10.0), (ex,  -9.2), ..arw)
  line((ex,  -8.2), (ex,  -7.6), ..arw)
  line((ex,  -7.2), (ex,  -6.6), ..arw)
  resid(ex, -13.55, ex - 1.65, -11.4)
  resid(ex,  -9.6,  ex - 1.65,  -7.4)

  // 本線（デコーダ）
  line((dx, -14.4), (dx, -13.2), ..arw)
  line((dx, -12.0), (dx, -11.4), ..arw)
  line((dx, -11.0), (dx, -10.4), ..arw)
  line((dx,  -9.8), (dx,  -9.0), ..arw)
  line((dx,  -8.0), (dx,  -7.4), ..arw)
  line((dx,  -7.0), (dx,  -6.4), ..arw)
  line((dx,  -5.8), (dx,  -5.0), ..arw)
  line((dx,  -4.0), (dx,  -3.4), ..arw)
  line((dx,  -3.0), (dx,  -2.4), ..arw)
  line((dx,  -1.8), (dx,  -0.6), ..arw)
  line((dx,   0.0), (dx,   0.6), ..arw)
  line((dx,   1.2), (dx,   2.0), ..arw)
  resid(dx, -13.55, dx + 1.65, -11.2)
  resid(dx,  -9.4,  dx + 1.65,  -7.2)
  resid(dx,  -5.4,  dx + 1.65,  -3.2)

  // エンコーダ出力をデコーダのCross-Attentionへ。枠の外を回って下から入れる
  line((ex, -6.0), (ex, -4.6), (dx - 2.15, -4.6), (dx - 2.15, -9.45),
    (dx - 0.75, -9.45), (dx - 0.75, -9.0), ..arw)

  // 埋め込みと位置エンコーディング
  let foot(cx, emb, tag, pe-left) = {
    blk(cx, -15.4, -16.4, emb, c-red, c-red-l)
    line((cx, -15.4), (cx, -14.8), ..arw)
    oplus(cx, -14.6)
    line((cx, -17.6), (cx, -16.4), ..arw)
    content((cx, -17.95), text(size: 9pt, tag))
    let px = if pe-left { cx - 2.6 } else { cx + 2.6 }
    circle((px, -14.6), radius: 0.3, stroke: black + 0.9pt, fill: white)
    line((px - 0.16, -14.6), (px - 0.08, -14.45), (px + 0.08, -14.75), (px + 0.16, -14.6),
      stroke: black + 0.7pt)
    if pe-left { line((px + 0.3, -14.6), (cx - r, -14.6), stroke: black + 0.9pt) }
    else       { line((px - 0.3, -14.6), (cx + r, -14.6), stroke: black + 0.9pt) }
    content((px, -15.35), text(size: 7pt)[Positional\ Encoding])
  }
  foot(ex, [Input\ Embedding],  [Inputs], true)
  foot(dx, [Output\ Embedding], [Outputs\ (shifted right)], false)

  content((dx, 2.35), text(size: 8pt)[Output Probabilities])
})
```

## Self-AttentionとCross-Attention
Transformerのエンコーダとデコーダのブロックには、Self-AttentionとCross-Attentionの二種類のAttentionが存在する。Self-AttentionはAttentionの入力であったクエリ、キー、バリューが全て同じ入力$bold(X)$から生成される。

$$
 bold(Q) = bold(X) bold(W)_Q quad bold(K) = bold(X) bold(W)_K quad bold(V) = bold(X) bold(W)_V
$$

Self-Attentionは、入力$bold(X)$の各トークン位置どうしの関係を見ながら表現を更新するためのもので、エンコーダとデコーダの両方で用いられる。 一方で、Cross-Attentionはクエリが入力$bold(X)$とは異なる入力$bold(Y)$から生成される。

$$
 bold(Q) = bold(Y) bold(W)_Q quad bold(K) = bold(X) bold(W)_K quad bold(V) = bold(X) bold(W)_V
$$

Cross-Attentionは、クエリを生成した入力$bold(Y)$を用いて、$bold(X)$の情報を集約するためのもので、デコーダがエンコーダ出力を参照しながら次のトークンを生成するために使われる。

## マルチヘッドAttention
TransformerのAttentionは、単一のAttentionではなく、複数のAttentionを並列に配置した**マルチヘッドAttention**（`Multi-Head Attention`）である。これはクエリ、キー、バリューのベクトルを複数の小さなベクトルに線形射影して、それぞれに独立したAttentionを適用し、最後にそれらの出力を結合するものである。マルチヘッドAttentionは、Transformerのエンコーダとデコーダの両方で使われる。

## マスク付きAttention
学習時のデコーダは正解系列をまとめて受け取れるが、そのままでは未来のトークンを見てしまい、推論時との条件がずれてしまう。そのため、未来位置に対応するスコアに$-infinity$を加え、Softmax後の重みが$0$になるようにする。具体的には、以下のような行列を用いて

$$
 bold(M) = mat(0, -infinity, dots.h, -infinity; 0, 0, dots.h, -infinity; dots.v, dots.v, dots.down, dots.v; 0, 0, dots.h, 0) quad quad M_(i j) = cases(
 -infinity quad & "if" j > i, 0 quad &"otherwise"
 )
$$

出力を以下のように計算する。

$$
 "MaskedAttention"(bold(Q), bold(K), bold(V)) = "softmax"(frac(bold(Q) bold(K)^top, sqrt(d_k)) + bold(M) ) bold(V)
$$

すると、重み行列のうち未来位置に対応する部分は$e^(-oo) = 0$となり、未来のトークンを参照できなくなる。Masked Attentionは、Transformerのデコーダ内のSelf-Attentionで使用される。

## 位置エンコーディング
Attentionは、RNNやLSTMのように順序を逐次的には処理しないため、そのままではトークンの並び順を区別できない。そこでTransformerは、各トークン表現にその位置を表すベクトルを加える。原論文では次のような正弦波型の位置エンコーディングが使われた。

$$
 "PE"_("pos", 2i) = sin(frac("pos", 10000^(2i slash d))) quad "PE"_("pos", 2i+1) = cos(frac("pos", 10000^(2i slash d)))
$$

ここで、$"pos"$は系列内の位置を表す整数であり、$2i$や$2i+1$はベクトルのインデックスである。$d$はトークン表現の次元数である。位置エンコーディングは入力埋め込み$bold(X)$に加えて使用される。

Position Encodingは以下の点で優れている。

- $bold("PE")$はトークン内容$bold(X)$に依存せず、位置だけから定まる。
- 正弦・余弦の加法定理により、固定オフセット$k$に対する$"PE"_("pos" + k)$を$"PE"_("pos")$の線形関数として表せる。
- Vaswaniらは、この設計が学習時より長い系列への外挿を助ける可能性を期待して、学習型ではなく正弦波型の位置エンコーディングを採用した。

## FFN（Feed-Forward Network）
Attentionは位置間の情報を混合するが、各位置に対する非線形変換は別途必要である。そのためTransformerは、各位置に同じ2層の全結合ネットワークを独立に適用するフィードフォワードネットワーク（`Feed-Forward Network`; `FFN`）を配置している。原論文ではReLUを用いた次の形で定義される。

$$
 "FFN"(bold(x)) = "max"(0, bold(x) bold(W)_1 + bold(b)_1) bold(W)_2 + bold(b)_2
$$

FFNは他の位置の情報を参照せず、各トークン位置の表現を個別に変換する。Transformerではこの層もエンコーダとデコーダの両方に含まれる。
