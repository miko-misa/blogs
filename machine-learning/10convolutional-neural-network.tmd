      )
    }
  }

  for i in (1, 2, 3, 4, 5) {
    for j in (1, 2, 3, 4) {
      block_3d(
        H: 0.3, W: 0.3, C: 0.3,
        origin_x: 1.2 - 1.2 * (i - 1),
