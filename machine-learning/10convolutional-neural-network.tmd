  )
  content("brace", [$f_H$], anchor: "south", padding: 0.2cm, angle: 90deg)

  block_3d(
    H: 0.85, W: 1, C: 0.3,
    origin_x: -1,
    origin_y: 10,
    origin_z: -1,
    color: red,
    width_size: 2pt,
    is_braced: true,
    text_H: text(size: 8pt)[$f_H$],
    text_W: text(size: 8pt)[$f_W$],
    text_C: text(size: 8pt)[$1$],
    background: red.transparentize(30%),
  )

  content((0, 1.5, -4), text(size: 10pt)[入力$bold(X)_(*,*,r)$])
  content((0, 1.5, 2.2), text(size: 10pt)[勾配$display((partial cal(L))/(partial bold(Y)^((k))))$])
  content((0, 6.3, -4), text(size: 10pt)[$display(tilde((partial cal(L))/(partial bold(Y)^((k)))))$])

  line((-1.4, 1.8, 4), (-1.4, 3.7, 4), mark: (end: "straight", xy-up: (1, 0, 0)), name: "sum")
  content(("sum.start", 0.9, "sum.end"), text(size: 7pt)[要素を分離], anchor: "north", padding: 0.1)

  line((0.3, 6, 3), (0.3, 6, 1.5), mark: (end: "straight", xy-up: (1, 0, 0)), name: "sum")
