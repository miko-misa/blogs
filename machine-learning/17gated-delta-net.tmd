```typst {scope=preamble}
#set page(fill: white, margin: 4pt)
#set text(font: ("New Computer Modern", "Noto Sans JP"))

#import "@preview/cetz:0.5.1"

// ============================================================
// CeTZ reusable block macros
//
// Provides:
// - rounded-block
// - trapezoid-block
// - rounded trapezoid support
// - center-content support
// - inner-draw callback support
// - custom anchors for trapezoid blocks
//
// Coordinate convention:
// - lt = left-top coordinate
// - rb = right-bottom coordinate
// - Intended mainly for numeric CeTZ canvas coordinates.
// ============================================================


// ============================================================
// 0. Basic point utilities
// ============================================================

#let _side-inset(length, shrink) = {
  // If shrink is a ratio, e.g. 30%,
  // the entire target side is shortened by 30%.
  // So each end moves inward by 15%.
  if type(shrink) == ratio {
    length * float(shrink) / 2
  } else {
    // If shrink is numeric, each end moves inward by this value.
    shrink
  }
}

#let _mid(a, b) = {
  (
    (a.at(0) + b.at(0)) / 2,
    (a.at(1) + b.at(1)) / 2,
  )
}

#let _pt-add(a, b) = {
  (a.at(0) + b.at(0), a.at(1) + b.at(1))
}

#let _pt-sub(a, b) = {
  (a.at(0) - b.at(0), a.at(1) - b.at(1))
}

#let _pt-scale(a, s) = {
  (a.at(0) * s, a.at(1) * s)
}

#let _pt-dist(a, b) = {
  let dx = a.at(0) - b.at(0)
  let dy = a.at(1) - b.at(1)
  calc.sqrt(dx * dx + dy * dy)
}

#let _pt-unit(a) = {
  let d = calc.sqrt(a.at(0) * a.at(0) + a.at(1) * a.at(1))
  if d == 0 {
    (0, 0)
  } else {
    (a.at(0) / d, a.at(1) / d)
  }
}


// ============================================================
// 1. Rectangle anchor helpers
// ============================================================

#let rect-anchor-pos(lt, rb, anchor-name) = {
  let lx = lt.at(0)
  let ty = lt.at(1)
  let rx = rb.at(0)
  let by = rb.at(1)
  
  let center = ((lx + rx) / 2, (ty + by) / 2)
  
  if anchor-name == "center" or anchor-name == "default" {
    center
  } else if anchor-name == "north" {
    ((lx + rx) / 2, ty)
  } else if anchor-name == "east" {
    (rx, (ty + by) / 2)
  } else if anchor-name == "south" {
    ((lx + rx) / 2, by)
  } else if anchor-name == "west" {
    (lx, (ty + by) / 2)
  } else if anchor-name == "north-east" {
    (rx, ty)
  } else if anchor-name == "south-east" {
    (rx, by)
  } else if anchor-name == "south-west" {
    (lx, by)
  } else if anchor-name == "north-west" {
    (lx, ty)
  } else {
    panic("unknown rect anchor: " + anchor-name)
  }
}

#let rect-anchors(lt, rb) = {
  (
    default: rect-anchor-pos(lt, rb, "center"),
    center: rect-anchor-pos(lt, rb, "center"),
    north: rect-anchor-pos(lt, rb, "north"),
    east: rect-anchor-pos(lt, rb, "east"),
    south: rect-anchor-pos(lt, rb, "south"),
    west: rect-anchor-pos(lt, rb, "west"),
    north-east: rect-anchor-pos(lt, rb, "north-east"),
    south-east: rect-anchor-pos(lt, rb, "south-east"),
    south-west: rect-anchor-pos(lt, rb, "south-west"),
    north-west: rect-anchor-pos(lt, rb, "north-west"),
  )
}


// ============================================================
// 2. Rounded rectangle block
// ============================================================

#let rounded-block(
  lt,
  rb,
  title,
  name: none,
  block-style: (
    fill: rgb("#f8fafc"),
    stroke: rgb("#334155") + 0.8pt,
    radius: 8pt,
  ),
  title-inset: 0.16,
  title-angle: 0deg,
  title-style: (
    anchor: "north",
    padding: (x: 4pt, y: 1pt),
    frame: none,
    wrap: text.with(
      size: 8pt,
      weight: "semibold",
      fill: rgb("#0f172a"),
    ),
  ),
  center-content: none,
  center-style: (
    anchor: "center",
    padding: (x: 2pt, y: 1pt),
    frame: none,
    wrap: text.with(
      size: 9pt,
      fill: rgb("#0f172a"),
    ),
  ),
  // Callback for drawing inside the same CeTZ canvas.
  // Receives an anchor dictionary:
  // a.center, a.north, a.east, a.south, a.west,
  // a.at("north-east"), etc.
  inner-draw: none,
) = {
  import cetz.draw: *
  
  let lx = lt.at(0)
  let ty = lt.at(1)
  let rx = rb.at(0)
  let by = rb.at(1)
  
  let bl = (lx, by)
  let tr = (rx, ty)
  
  let anchors = rect-anchors(lt, rb)
  
  rect(
    bl,
    tr,
    name: name,
    ..block-style,
  )
  
  if inner-draw != none {
    inner-draw(anchors)
  }
  
  if center-content != none {
    content(
      anchors.center,
      center-content,
      ..center-style,
    )
  }
  
  if title != none {
    content(
      ((lx + rx) / 2, ty - title-inset),
      title,
      angle: title-angle,
      ..title-style,
    )
  }
}


// ============================================================
// 3. Trapezoid geometry
// ============================================================

#let trapezoid-points(
  lt,
  rb,
  side: "top",
  shrink: 30%,
) = {
  let lx = lt.at(0)
  let ty = lt.at(1)
  let rx = rb.at(0)
  let by = rb.at(1)
  
  let w = rx - lx
  let h = ty - by
  
  if side == "top" or side == "north" or side == "up" {
    let d = _side-inset(w, shrink)
    (
      (lx, by),
      (rx, by),
      (rx - d, ty),
      (lx + d, ty),
    )
  } else if side == "right" or side == "east" {
    let d = _side-inset(h, shrink)
    (
      (lx, by),
      (rx, by + d),
      (rx, ty - d),
      (lx, ty),
    )
  } else if side == "bottom" or side == "south" or side == "down" {
    let d = _side-inset(w, shrink)
    (
      (lx + d, by),
      (rx - d, by),
      (rx, ty),
      (lx, ty),
    )
  } else if side == "left" or side == "west" {
    let d = _side-inset(h, shrink)
    (
      (lx, by + d),
      (rx, by),
      (rx, ty),
      (lx, ty - d),
    )
  } else {
    panic("unknown side: " + side)
  }
}

#let trapezoid-anchor-pos(pts, anchor-name) = {
  let p0 = pts.at(0)
  let p1 = pts.at(1)
  let p2 = pts.at(2)
  let p3 = pts.at(3)
  
  let center = (
    (p0.at(0) + p1.at(0) + p2.at(0) + p3.at(0)) / 4,
    (p0.at(1) + p1.at(1) + p2.at(1) + p3.at(1)) / 4,
  )
  
  if anchor-name == "center" or anchor-name == "default" {
    center
  } else if anchor-name == "north" {
    _mid(p2, p3)
  } else if anchor-name == "east" {
    _mid(p1, p2)
  } else if anchor-name == "south" {
    _mid(p0, p1)
  } else if anchor-name == "west" {
    _mid(p3, p0)
  } else if anchor-name == "north-east" {
    p2
  } else if anchor-name == "south-east" {
    p1
  } else if anchor-name == "south-west" {
    p0
  } else if anchor-name == "north-west" {
    p3
  } else {
    panic("unknown trapezoid anchor: " + anchor-name)
  }
}

#let trapezoid-anchors(pts) = {
  (
    default: trapezoid-anchor-pos(pts, "center"),
    center: trapezoid-anchor-pos(pts, "center"),
    north: trapezoid-anchor-pos(pts, "north"),
    east: trapezoid-anchor-pos(pts, "east"),
    south: trapezoid-anchor-pos(pts, "south"),
    west: trapezoid-anchor-pos(pts, "west"),
    north-east: trapezoid-anchor-pos(pts, "north-east"),
    south-east: trapezoid-anchor-pos(pts, "south-east"),
    south-west: trapezoid-anchor-pos(pts, "south-west"),
    north-west: trapezoid-anchor-pos(pts, "north-west"),
  )
}


// ============================================================
// 4. Rounded polygon path
// ============================================================

#let _corner-radius-value(lt, rb, corner-radius) = {
  let lx = lt.at(0)
  let ty = lt.at(1)
  let rx = rb.at(0)
  let by = rb.at(1)
  
  let w = calc.abs(rx - lx)
  let h = calc.abs(ty - by)
  
  if type(corner-radius) == ratio {
    calc.min(w, h) * float(corner-radius)
  } else {
    corner-radius
  }
}

#let rounded-polygon-data(pts, radius) = {
  let n = pts.len()
  let result = ()
  
  for i in range(0, n) {
    let prev = pts.at(if i == 0 { n - 1 } else { i - 1 })
    let cur = pts.at(i)
    let next = pts.at(if i == n - 1 { 0 } else { i + 1 })
    
    let len-prev = _pt-dist(cur, prev)
    let len-next = _pt-dist(cur, next)
    
    let r = calc.min(
      radius,
      calc.min(len-prev / 2, len-next / 2),
    )
    
    let dir-prev = _pt-unit(_pt-sub(prev, cur))
    let dir-next = _pt-unit(_pt-sub(next, cur))
    
    let pin = _pt-add(cur, _pt-scale(dir-prev, r))
    let pout = _pt-add(cur, _pt-scale(dir-next, r))
    
    result.push((
      corner: cur,
      pin: pin,
      pout: pout,
    ))
  }
  
  result
}

#let rounded-polygon-path(
  pts,
  radius,
  style,
) = {
  import cetz.draw: *
  
  if radius <= 0 {
    line(
      ..pts,
      close: true,
      ..style,
    )
  } else {
    let data = rounded-polygon-data(pts, radius)
    let n = data.len()
    
    let commands = ()
    
    commands.push(("M", data.at(0).at("pout")))
    
    for i in range(1, n) {
      let d = data.at(i)
      commands.push(("L", d.at("pin")))
      commands.push(("Q", d.at("corner"), d.at("pout")))
    }
    
    let d0 = data.at(0)
    commands.push(("L", d0.at("pin")))
    commands.push(("Q", d0.at("corner"), d0.at("pout")))
    
    // In CeTZ 0.5.2, lowercase "z" closes the subpath as closed.
    commands.push(("z",))
    
    svg-path(
      ..commands,
      ..style,
    )
  }
}


// ============================================================
// 5. Trapezoid block
// ============================================================

#let _draw-trapezoid-body(
  pts,
  title,
  title-pos,
  block-style,
  title-style,
  corner-radius,
  center-content,
  center-style,
  inner-draw,
) = {
  import cetz.draw: *
  
  let anchors = trapezoid-anchors(pts)
  
  rounded-polygon-path(
    pts,
    corner-radius,
    block-style,
  )
  
  if inner-draw != none {
    inner-draw(anchors)
  }
  
  if center-content != none {
    content(
      anchors.center,
      center-content,
      ..center-style,
    )
  }
  
  if title != none {
    content(
      title-pos,
      title,
      ..title-style,
    )
  }
}

#let trapezoid-block(
  lt,
  rb,
  title,
  name: none,
  // Which side is shrunk toward its own center.
  // Available values:
  // - "top", "north", "up"
  // - "right", "east"
  // - "bottom", "south", "down"
  // - "left", "west"
  side: "top",
  // ratio:
  //   shrink: 30% means the target side becomes 30% shorter in total.
  // number:
  //   shrink: 0.3 means each endpoint moves inward by 0.3.
  shrink: 30%,
  // 0 means sharp trapezoid.
  // number means canvas-unit corner radius.
  // ratio means ratio of the shorter side of the bounding rectangle.
  corner-radius: 0,
  block-style: (
    fill: rgb("#f8fafc"),
    stroke: rgb("#334155") + 0.8pt,
  ),
  title-inset: 0.16,
  title-style: (
    anchor: "north",
    padding: (x: 4pt, y: 1pt),
    frame: none,
    wrap: text.with(
      size: 8pt,
      weight: "semibold",
      fill: rgb("#0f172a"),
    ),
  ),
  center-content: none,
  center-style: (
    anchor: "center",
    padding: (x: 2pt, y: 1pt),
    frame: none,
    wrap: text.with(
      size: 9pt,
      fill: rgb("#0f172a"),
    ),
  ),
  // Callback for drawing inside the same CeTZ canvas.
  // Receives an anchor dictionary:
  // a.center, a.north, a.east, a.south, a.west,
  // a.at("north-east"), etc.
  inner-draw: none,
) = {
  import cetz.draw: *
  
  let lx = lt.at(0)
  let ty = lt.at(1)
  let rx = rb.at(0)
  
  let pts = trapezoid-points(
    lt,
    rb,
    side: side,
    shrink: shrink,
  )
  
  let anchors = trapezoid-anchors(pts)
  
  let title-pos = ((lx + rx) / 2, ty - title-inset)
  
  let resolved-radius = _corner-radius-value(
    lt,
    rb,
    corner-radius,
  )
  
  if name == none {
    _draw-trapezoid-body(
      pts,
      title,
      title-pos,
      block-style,
      title-style,
      resolved-radius,
      center-content,
      center-style,
      inner-draw,
    )
  } else {
    group(name: name, {
      _draw-trapezoid-body(
        pts,
        title,
        title-pos,
        block-style,
        title-style,
        resolved-radius,
        center-content,
        center-style,
        inner-draw,
      )
      
      anchor("default", anchors.default)
      anchor("center", anchors.center)
      
      anchor("north", anchors.north)
      anchor("east", anchors.east)
      anchor("south", anchors.south)
      anchor("west", anchors.west)
      
      anchor("north-east", anchors.at("north-east"))
      anchor("south-east", anchors.at("south-east"))
      anchor("south-west", anchors.at("south-west"))
      anchor("north-west", anchors.at("north-west"))
    })
  }
}


#let route-step(start, end, turn: 50%, dir: "h") = {
  // turnに `(1.5, 0)` のような配列が渡された場合は、startからの相対座標として扱う
  // それ以外（`50%` など）の場合は、startとendの中間点として扱う
  let turn-pt = if type(turn) == array {
    (rel: turn, to: start)
  } else {
    (start, turn, end)
  }
  
  if dir == "h" {
    // 横 → 縦 → 横 （デフォルト）
    (
      start,
      (start, "-|", turn-pt),
      (end, "-|", turn-pt),
      end,
    )
  } else if dir == "v" {
    // 縦 → 横 → 縦
    (
      start,
      (start, "|-", turn-pt),
      (end, "|-", turn-pt),
      end,
    )
  }
}

#import "@preview/cetz:0.5.2" as cetz

#let tile-id(name, row, col) = {
  name + "-" + str(row) + "-" + str(col)
}

#let normalize-gap(gap) = {
  if type(gap) == dictionary {
    (
      x: gap.at("x", default: 0),
      y: gap.at("y", default: 0),
    )
  } else {
    (
      x: gap.at(0),
      y: gap.at(1),
    )
  }
}

#let gap-value(spec, i) = {
  if i < 0 {
    0
  } else if type(spec) == function {
    let result = spec(i)
    if result == none { 0 } else { result }
  } else if type(spec) == array {
    spec.at(i, default: 0)
  } else {
    spec
  }
}

#let gap-sum-before(spec, n) = {
  let result = 0
  if n > 0 {
    for i in range(n) {
      result += gap-value(spec, i)
    }
  }
  result
}

#let gap-sum-from(spec, start, count) = {
  let result = 0
  if count > 0 {
    for i in range(start, start + count) {
      result += gap-value(spec, i)
    }
  }
  result
}

#let merge-span(merge) = {
  if "span" in merge {
    merge.span
  } else {
    let axis = merge.at("axis", default: "x")
    let len = merge.at("len", default: 1)

    if axis == "x" {
      (len, 1)
    } else {
      (1, len)
    }
  }
}

#let tiled-rects(
  name,
  left-top,
  cell,
  count,
  gap: (0, 0),
  style: (:),
  overrides: (:),
  merges: (),
) = {
  import cetz.draw: rect

  let x0 = left-top.at(0)
  let y0 = left-top.at(1)

  let w = cell.at(0)
  let h = cell.at(1)

  let cols = count.at(0)
  let rows = count.at(1)

  let gaps = normalize-gap(gap)
  let gx = gaps.x
  let gy = gaps.y

  let total-w = cols * w + gap-sum-before(gx, cols - 1)
  let total-h = rows * h + gap-sum-before(gy, rows - 1)

  rect(
    (x0, y0 - total-h),
    (rel: (total-w, total-h)),
    name: name,
    fill: none,
    stroke: none,
  )

  let cell-left(col) = {
    x0 + col * w + gap-sum-before(gx, col)
  }

  let cell-top(row) = {
    y0 - row * h - gap-sum-before(gy, row)
  }

  let merge-start(row, col) = {
    let result = none

    for merge in merges {
      let start = merge.at("start")
      let sr = start.at(0)
      let sc = start.at(1)

      if row == sr and col == sc {
        result = merge
      }
    }

    result
  }

  let in-merge(row, col) = {
    let result = false

    for merge in merges {
      let start = merge.at("start")
      let sr = start.at(0)
      let sc = start.at(1)

      let span = merge-span(merge)
      let span-cols = span.at(0)
      let span-rows = span.at(1)

      if row >= sr and row < sr + span-rows and col >= sc and col < sc + span-cols {
        result = true
      }
    }

    result
  }

  let resolve-override(info, id, short-id) = {
    if type(overrides) == function {
      let result = overrides(info)
      if result == none { (:) } else { result }
    } else {
      overrides.at(
        id,
        default: overrides.at(short-id, default: (:)),
      )
    }
  }

  for row in range(rows) {
    for col in range(cols) {
      let px = cell-left(col)
      let py = cell-top(row)

      let merge = merge-start(row, col)

      if merge != none {
        let span = merge-span(merge)
        let span-cols = span.at(0)
        let span-rows = span.at(1)

        let tag = merge.at("id", default: none)
        let merge-style = merge.at("style", default: (:))

        let mw = span-cols * w + gap-sum-from(gx, col, span-cols - 1)
        let mh = span-rows * h + gap-sum-from(gy, row, span-rows - 1)

        let id = if tag == none {
          tile-id(name, row, col)
        } else {
          name + "-" + tag
        }

        let short-id = if tag == none {
          str(row) + "-" + str(col)
        } else {
          tag
        }

        let info = (
          kind: "merge",
          row: row,
          col: col,
          x: col,
          y: row,
          span: span,
          span-cols: span-cols,
          span-rows: span-rows,
          name: id,
          left-top: (px, py),
          left-bottom: (px, py - mh),
          right-top: (px + mw, py),
          right-bottom: (px + mw, py - mh),
          center: (px + mw / 2, py - mh / 2),
        )

        let local-style = resolve-override(info, id, short-id)

        rect(
          info.left-bottom,
          info.right-top,
          name: id,
          ..(style + merge-style + local-style),
        )
      } else if not in-merge(row, col) {
        let id = tile-id(name, row, col)
        let short-id = str(row) + "-" + str(col)

        let info = (
          kind: "cell",
          row: row,
          col: col,
          x: col,
          y: row,
          span: (1, 1),
          span-cols: 1,
          span-rows: 1,
          name: id,
          left-top: (px, py),
          left-bottom: (px, py - h),
          right-top: (px + w, py),
          right-bottom: (px + w, py - h),
          center: (px + w / 2, py - h / 2),
        )

        let local-style = resolve-override(info, id, short-id)

        rect(
          info.left-bottom,
          info.right-top,
          name: id,
          ..(style + local-style),
        )
      }
    }
  }
}

// lab の figures.typ に合わせた配色
#let c-blue = rgb("1d5fbf")
#let c-blue-l = rgb("eff6ff")
#let c-teal = rgb("0f766e")
#let c-teal-l = rgb("ecfeff")
#let c-green = rgb("16a34a")
#let c-green-l = rgb("f0fdf4")
#let c-red = rgb("dd5a5a")
#let c-red-l = rgb("ffe5e5")
#let c-purple = rgb("7c3aed")
#let c-purple-l = rgb("faf5ff")
#let c-orange = rgb("eb7507")
#let c-orange-l = rgb("fff7ed")
#let c-gray = rgb("a1aab6")
#let c-gray-l = rgb("f8fafc")

#let bs(sc, fc) = (fill: fc, stroke: sc + 1pt, radius: 5pt)
#let lbl(s) = text(size: 8pt, weight: "semibold", fill: black, s)
#let arw = (mark: (end: "triangle", fill: black, scale: 0.7), stroke: black + 0.9pt)
```

# Gated Delta Net
## 概要
Gated Delta Netは系列データを扱うモデルであり、Attentionをベースにしている。Attentionは過去系列の情報を現在の入力に応じて重み付けして出力を計算するため、key-valueペアを記憶する必要がある。Attentionの指数関数を分解できる形で近似したLinear Attentionでは、このkey-valueペアを行列$bold(S)_t$に圧縮できる。正規化して分母を落とせば、更新は単純な漸化式ひとつで済む。ただしこの漸化式は足すことしかできず、大きさの決まった$bold(S)_t$に情報を足し続けるので中身が飽和してしまう。Gated Delta Netでは、キーの方向だけを書き換える更新と、状態全体を薄れさせる減衰の2つを持たせることで、ピンポイントな上書きと不要な記憶の消去を両立させている。

長い系列を扱うほど、過去をすべて保持するAttentionに対して有利になる。実際、言語モデリングや長文の理解ではTransformerと同等以上の性能が報告されている。一方で、過去の任意の位置をそのまま引いてくるような検索では及ばない。固定サイズの状態に圧縮する以上、そこに入り切らない情報は失われるためである。そのため実際には、層の大部分をGated Delta Netにして一部にAttentionを混ぜた、ハイブリッドの形で使われることが多い。

## Linear Attention
一般的なAttentionでは系列の1要素$bold(x)_t$から線形変換でクエリ・キー・バリューを作った。

$$
bold(q)_t = W_q bold(x)_t, quad bold(k)_t = W_k bold(x)_t, quad bold(v)_t = W_v bold(x)_t
$$

ここで形状は$bold(q)_t, bold(k)_t in RR^(d_k)$、$bold(v)_t in RR^(d_v)$とする。すると、現在時刻$t$までの情報のみをみるCausal Attentionでは、出力$bold(y)_t$は

$$
bold(y)_t = sum_(i=1)^t exp(bold(q)_t^top bold(k)_i slash sqrt(d_k))  / (sum_(j=1)^t exp(bold(q)_t^top bold(k)_j slash sqrt(d_k))) bold(v)_i
$$

で計算できる。ここで、非線形な$exp$関数を次のような因数分解可能な関数$phi.alt: RR^(d_k) -> RR^(d_phi.alt)$で近似してみる。

$$
exp(bold(q)_t^top bold(k)_i slash sqrt(d_k)) approx phi.alt(bold(q)_t)^top phi.alt(bold(k)_i)
$$

すると、これを用いたAttentionの出力は次のように書き換えられる。

$$
bold(y)_t = sum_(i=1)^t (phi.alt(bold(q)_t)^top phi.alt(bold(k)_i))  / (sum_(j=1)^t phi.alt(bold(q)_t)^top phi.alt(bold(k)_j)) bold(v)_i
$$

これは一般的にLinear Attentionと呼ばれる。分子について考えると、

$$
sum_(i=1)^t (phi.alt(bold(q)_t)^top phi.alt(bold(k)_i)) bold(v)_i &= sum_(i=1)^t bold(v)_i phi.alt(bold(k)_i)^top phi.alt(bold(q)_t)\
&= (sum_(i=1)^t bold(v)_i phi.alt(bold(k)_i)^top) phi.alt(bold(q)_t)\
&= (sum_(i=1)^t phi.alt(bold(k)_i) bold(v)_i^top)^top phi.alt(bold(q)_t)
$$

となる。ここで、

$$
bold(S)_t &:= sum_(i=1)^t phi.alt(bold(k)_i) bold(v)_i^top in RR^(d_phi.alt times d_v)\
bold(n)_t &:= sum_(i=1)^t phi.alt(bold(k)_i) in RR^(d_phi.alt)
$$

と定義すると

$$
bold(y)_t = (bold(S)_t^top phi.alt(bold(q)_t)) / (bold(n)_t^top phi.alt(bold(q)_t))
$$
と表せる。また、これらは定義より以下の漸化式で再帰的に計算できる。
$$
bold(S)_t &= bold(S)_(t-1) + phi.alt(bold(k)_t) bold(v)_t^top\
bold(n)_t &= bold(n)_(t-1) + phi.alt(bold(k)_t)
$$

## Delta Rule
Gated Delta Netでは上記の計算において分母を無視する。これは正規化のために分母を計算する必要があるが、別の部分で正規化を行うことにする。つまり以下のように$bold(q)_t, bold(k)_t$があらかじめ正規化されているとする。
$$
||phi.alt(bold(q)_t)||_2 = ||phi.alt(bold(k)_t)||_2 = 1
$$
また、その後の出力も正規化したものとすると以降は簡単のため
$$
phi.alt(bold(q)_t) -> bold(q)_t, quad phi.alt(bold(k)_t) -> bold(k)_t
$$
と書くことにする。すると、Linear Attentionは次のように書き換えられる。
$$
bold(S)_t &= bold(S)_(t-1) + bold(k)_t bold(v)_t^top\
bold(y)_t &= bold(S)_t^top bold(q)_t
$$

ここで、$bold(S)_t^top$はkeyのベクトル空間をvalueのベクトル空間に写す線形変換である。なぜなら、$bold(S)^top$が一つのkey-valueペアを記憶していると仮定する。つまり、$bold(S) = bold(k) bold(v)^top$とすると、正規化されたベクトルの元では
$$
bold(S)^top bold(k) = (bold(k) bold(v)^top)^top bold(k) = bold(v) (bold(k)^top bold(k)) = bold(v) quad (because ||bold(k)||_2 = 1)
$$

が成立する。逆に$bold(k)^top bold(q) = 0$のとき
$$
bold(S)^top bold(q) = (bold(k) bold(v)^top)^top bold(q) = bold(v) (bold(k)^top bold(q)) = 0
$$
となる。つまり、$bold(S)^top$はkeyのベクトル空間をvalueのベクトル空間に写す線形変換である。さて、この前提において$bold(S)_t^top bold(k)_t$を計算してみると、
$$
bold(S)_t^top bold(k)_t = (bold(S)_(t-1) + bold(k)_t bold(v)_t^top)^top bold(k)_t = bold(S)_(t-1)^top bold(k)_t + bold(v)_t (bold(k)_t^top bold(k)_t) = bold(S)_(t-1)^top bold(k)_t + bold(v)_t
$$
つまり、$bold(S)_t^top bold(k)_t$は真に$bold(k)_t$を$bold(v)_t$に写すような変換にはなっていない。$bold(S)_(t-1)^top bold(k)_t$が残ってしまう。そこで、$bold(S)_t^top$を$bold(k)_t |-> bold(v)_t$となるような変換になるためにオンライン学習される（Gated Delta Netを学習する段階ではなく、推論時にある意味で学習される）ものだと捉える。損失関数は単純に以下のように定義する。
$$
cal(L)_t (bold(S)) = 1/2 ||bold(S)^top bold(k)_t - bold(v)_t||_2^2
$$
すると、その勾配は
$$
nabla_(bold(S)) cal(L)_t (bold(S)) = bold(k)_t (bold(S)^top bold(k)_t - bold(v)_t)^top
$$
とある。これを用いて、$bold(S)_(t-1)$をいわゆる勾配法で更新して$bold(S)_t$とする。つまり、学習率$beta_t > 0$を用いて
$$
bold(S)_t &= bold(S)_(t-1) - beta_t nabla_(bold(S)) cal(L)_t (bold(S)_(t-1))\
&= bold(S)_(t-1) - beta_t bold(k)_t (bold(S)_(t-1)^top bold(k)_t - bold(v)_t)^top\
&= bold(S)_(t-1) + beta_t bold(k)_t (bold(v)_t - bold(S)_(t-1)^top bold(k)_t)^top
$$
となる。これが Delta Rule である。このDelta Ruleがちゃんと新たな$bold(v)_t$を復元できることを確認する。$bold(S)_(t-1)^top bold(k)_t = hat(bold(v))_t$のとき、更新後の$bold(S)_t^top bold(k)_t$は

$$
bold(S)_t^top bold(k)_t &= (bold(S)_(t-1) + beta_t bold(k)_t (bold(v)_t - hat(bold(v))_t)^top)^top bold(k)_t\
&= bold(S)_(t-1)^top bold(k)_t + beta_t (bold(v)_t - hat(bold(v))_t)(bold(k)_t^top bold(k)_t)\
&= hat(bold(v))_t + beta_t (bold(v)_t - hat(bold(v))_t) quad (because ||bold(k)_t||_2 = 1)\
&= (1 - beta_t) hat(bold(v))_t + beta_t bold(v)_t
$$

となる。つまり、$bold(S)_t^top bold(k)_t$は$bold(v)_t$に向かって更新されることがわかる。このままではKey$bold(k)_t$の方向に沿った更新しかできないので全体に減衰をかけるため、係数$0 < alpha_t < 1$を用いて$bold(S)_t$への更新時、$bold(S)_(t-1)$を$alpha_t bold(S)_(t-1)$とする。これを計算すると、
$$
bold(S)_t &= alpha_t bold(S)_(t-1) + beta_t bold(k)_t (bold(v)_t - alpha_t bold(S)_(t-1)^top bold(k)_t)^top\
&= alpha_t bold(S)_(t-1) + beta_t bold(k)_t bold(v)_t^top - alpha_t beta_t bold(k)_t bold(k)_t^top bold(S)_(t-1)\
&= alpha_t ( I - beta_t bold(k)_t bold(k)_t^top) bold(S)_(t-1) + beta_t bold(k)_t bold(v)_t^top
$$
となり、Delta Ruleは以下のようにまとめられる。

$$
bold(S)_t &= alpha_t ( I - beta_t bold(k)_t bold(k)_t^top) bold(S)_(t-1) + beta_t bold(k)_t bold(v)_t^top\
bold(y)_t &= bold(S)_t^top bold(q)_t
$$

## マルチヘッド化とGDNのブロック構造
シーケンスの1入力$bold(x)_t$からDelta Ruleで用いるための$bold(k)_t, bold(v)_t, bold(q)_t, alpha_t, beta_t$を作り、Delta Ruleから出力を得るまでを一つのブロックと考えることができる。それには色々な方法が考えられ、採用されるモデルによって多少のバリエーションがある。ここでは、元論文のもので説明する。

```typst {render=svg caption="Gated Delta Netのブロック構造"}
#cetz.canvas(length: 1cm, {
  import cetz.draw: *

  let hw = 0.95
  let h  = 0.7
  let r  = 0.2

  let box(cx, yt, label, sc, fc) = {
    rounded-block((cx - hw, yt), (cx + hw, yt - h), none,
      block-style: bs(sc, fc), center-content: lbl(label))
  }
  // 線形変換は台形にして、写像であることを形で示す
  let proj(cx, yt, label, shr) = {
    trapezoid-block((cx - hw, yt), (cx + hw, yt - h), none,
      side: "top", shrink: shr, corner-radius: 0.12,
      block-style: (fill: c-purple-l, stroke: c-purple + 1pt),
      center-content: lbl(label))
  }
  let odot(x, y) = {
    circle((x, y), radius: r, stroke: black + 0.9pt, fill: white)
    circle((x, y), radius: 0.055, stroke: none, fill: black)
  }
  let tag(x, y, s) = content((x, y), text(size: 7.5pt, s))

  let xq = 0.0
  let xk = 2.2
  let xv = 4.4
  let xb = 6.6
  let xa = 8.8
  let xg = 12.4
  let ydr = -6.8      // Delta Rule の下端
  let ybus = -12.4

  // ヘッドを表すカード。後ろに2枚重ねる
  let card(dx, dy) = {
    rounded-block((-1.35 + dx, -3.5 + dy), (10.15 + dx, -12.05 + dy), none,
      block-style: (fill: c-gray-l, stroke: c-gray + 1pt, radius: 8pt))
  }
  card(0.9, 0.44)
  card(0.45, 0.22)
  card(0, 0)
  content((-2.3, -7.8), text(size: 9pt)[$times H$])

  // 入力の母線。ここから各列へ分かれる
  content((xv, -13.5), text(size: 9pt, $bold(x)_t$))
  line((xv, -13.2), (xv, ybus), ..arw)
  line((xq, ybus), (xg, ybus), stroke: black + 0.9pt)

  // 各列は1本の線が貫く。ブロックは線の上に重ねる
  for x in (xq, xk, xv, xb, xa) { line((x, ybus), (x, ydr), ..arw) }
  line((xg, ybus), (xg, -4.0), (xv + r, -4.0), ..arw)

  proj(xq, -11.0, [$bold(W)_q$],      30%)
  proj(xk, -11.0, [$bold(W)_k$],      30%)
  proj(xv, -11.0, [$bold(W)_v$],      30%)
  proj(xb, -11.0, [$bold(w)_beta$],   60%)
  proj(xa, -11.0, [$bold(w)_alpha$],  60%)
  proj(xg, -11.0, [$bold(W)_"gate"$], 30%)

  box(xq, -9.8, [ShortConv], c-blue,   c-blue-l)
  box(xk, -9.8, [ShortConv], c-blue,   c-blue-l)
  box(xv, -9.8, [ShortConv], c-blue,   c-blue-l)
  box(xb, -9.8, [Sigmoid],   c-orange, c-orange-l)
  box(xa, -9.8, [Softplus],  c-orange, c-orange-l)
  box(xg, -9.8, [SiLU],      c-orange, c-orange-l)

  box(xq, -8.6, [SiLU], c-orange, c-orange-l)
  box(xk, -8.6, [SiLU], c-orange, c-orange-l)
  box(xv, -8.6, [SiLU], c-orange, c-orange-l)
  box(xa, -8.6, [$exp(-e^a dot)$], c-orange, c-orange-l)

  box(xq, -7.4, [L2Norm], c-teal, c-teal-l)
  box(xk, -7.4, [L2Norm], c-teal, c-teal-l)

  tag(xq + 0.45, -7.05, $bold(q)_t$)
  tag(xk + 0.45, -7.05, $bold(k)_t$)
  tag(xv + 0.45, -7.05, $bold(v)_t$)
  tag(xb + 0.45, -7.05, $beta_t$)
  tag(xa + 0.45, -7.05, $alpha_t$)

  rounded-block((-1.1, -5.8), (9.9, ydr), none,
    block-style: bs(c-green, c-green-l), center-content: lbl([Delta Rule]))

  // Delta Rule から乗算まで、こちらも1本の線が貫く
  line((xv, -5.8), (xv, -4.2), ..arw)
  tag(xv + 0.62, -5.55, $bold(y)_t^((h))$)
  box(xv, -4.6, [RMSNorm], c-teal, c-teal-l)
  odot(xv, -4.0)

  // 各カードから Concat へ集まる
  line((xv, -3.8), (xv, -2.3), ..arw)
  line((xv + 0.45, -3.28), (xv + 0.45, -2.3), ..arw)
  line((xv + 0.9, -3.06), (xv + 0.9, -2.3), ..arw)
  tag(xv - 0.85, -2.72, $hat(bold(y))_t^((h))$)

  rounded-block((3.0, -1.6), (6.7, -2.3), none,
    block-style: bs(c-gray, c-gray-l), center-content: lbl([Concat]))
  line((4.85, -1.6), (4.85, -1.0), ..arw)
  proj(4.85, -0.3, [$bold(W)_"out"$], 30%)
  line((4.85, -0.3), (4.85, 0.35), ..arw)
  content((4.85, 0.68), text(size: 9pt, $bold(y)_t$))
})
```


まず、基本的にはマルチヘッドを採用する。Delta Ruleの計算を同じ入力に対して複数回行う。ヘッド$h = 1, 2, ..., H$に対して、$bold(k)_t^((h)), bold(v)_t^((h)), bold(q)_t^((h)), alpha_t^((h)), beta_t^((h))$を作って

$$
bold(S)_t^((h)) &= alpha_t^((h)) ( I - beta_t^((h)) bold(k)_t^((h)) (bold(k)_t^((h)))^top) bold(S)_(t-1)^((h)) + beta_t^((h)) bold(k)_t^((h)) (bold(v)_t^((h)))^top\
bold(y)_t^((h)) &= (bold(S)_t^((h)))^top bold(q)_t^((h))
$$

を計算する。さて、各パラメータの計算方法を説明する。Attentionと同様に、クエリ・キー・バリューは線形変換で得られる。

$$
hat(bold(q))^((h))_t = W^((h))_q bold(x)_t, quad hat(bold(k))^((h))_t = W^((h))_k bold(x)_t, quad hat(bold(v))^((h))_t = W^((h))_v bold(x)_t
$$

つまり、入力行列$bold(X) = (bold(x)_1, bold(x)_2, ..., bold(x)_T)^top$から

$$
hat(bold(Q))^((h)) = bold(X) (W^((h))_q)^top, quad hat(bold(K))^((h)) = bold(X) (W^((h))_k)^top, quad hat(bold(V))^((h)) = bold(X) (W^((h))_v)^top
$$

しかし、これらは正規化されていないので、正規化を行う。また、同時に時間方向に畳み込みを行う。この畳み込みは`ShortConv`と呼ばれるものだが、Mambaのものと同様で過去のいくつかの時刻の情報をDepthwiseで畳み込むものである。
重み$bold(W)_"conv"$を用いて以下のように計算される。
$$
["ShortConv"(dot)]_(ell, d) = sum_(0 <= ell' < K\ ell' <= ell) [bold(W)_"conv"]_(ell', d) [dot]_(ell - ell', d)
$$
なお、$K$は畳み込みのカーネルサイズである。また、正規化はL2正規化を行う。つまり、$bold(z) in RR^d$に対して
$$
"L2Norm"(bold(z)) = bold(z) / (||bold(z)||_2)
$$
と計算する。ただ、行列に対しては
$$
"L2Norm"(mat(bold(z)_1^top; dots.v; bold(z)_T^top)) = mat("L2Norm"(bold(z)_1)^top; dots.v; "L2Norm"(bold(z)_T)^top)
$$
のように、各行ベクトルごとに正規化を行う。これらを用いて、$bold(k)_t, bold(q)_t, bold(v)_t$は以下のように計算される。
$$
bold(k)_t^((h)) = "L2Norm"("SiLU"("ShortConv"(hat(bold(K))^((h)))_t))\
bold(q)_t^((h)) = "L2Norm"("SiLU"("ShortConv"(hat(bold(Q))^((h)))_t))\
bold(v)_t^((h)) = "SiLU"("ShortConv"(hat(bold(V))^((h)))_t)
$$
$bold(v)_t^((h))$は今までの議論から正規化を行う必要はないが、出力で正規化を行うことになる。$beta_t^((h))$は入力$bold(x)_t$とパラメータとの内積をシグモイド関数で正規化することで得られる。概念的には1ニューロンへのバイアスなしの全結合である。
$$
beta_t^((h)) = "Sigmoid"((bold(w)^((h))_beta)^top bold(x)_t)
$$
対して、$alpha_t^((h))$は以下のように計算する。
$$
alpha_t^((h)) = exp[-exp(a^((h))_alpha) "softplus"((bold(w)^((h))_alpha)^top bold(x)_t + b^((h))_alpha)]
$$
$a^((h))_alpha, b^((h))_alpha$はスカラー、$bold(w)^((h))_alpha in RR^(d_x)$はベクトルであり、これらは学習されるパラメータである。`softplus`関数は以下のように定義される。
$$
"softplus"(z) = log(1 + exp(z))
$$

これは$beta$は単純にkey方向に沿った更新の大きさを決めるため単純に係数を作るだけでいいが、$alpha$は減衰の大きさを決めるため指数減衰の形にする必要があるためである。指数減衰には様々な**都合の良い**性質があることが知られている。

さて、Delta Ruleによって得られた各ヘッドの出力を$bold(y)_t^((h))$とすると、`RMSNorm`正規化を行う。`RMSNorm`正規化とは以下のようなものである。
$$
"RMSNorm"(bold(z)) = bold(gamma) dot.o bold(z) / sqrt(1/d_z sum_(i=1)^(d_z) bold(z)_i^2 + epsilon)
$$
`RMS`とはRoot Mean Squareの略であり、ベクトルの各要素の二乗平均平方根で正規化することを意味する。それだけでなく、正規化後に学習されるパラメータ$bold(gamma) in RR^(d_z)$を要素ごとに掛けることで、正規化後のスケールを調整することができる。`RMSNorm`は`LayerNorm`と同様の効果があるが、平均を引く操作がないため計算コストが低いという利点がある。これらはヘッドごとに独立に計算される。さらに、それぞれに対して入力との `gating` を行う。
$$
hat(bold(y))_t^((h)) = "RMSNorm"(bold(y)_t^((h))) dot.o phi.alt(bold(W)_"gate" bold(x)_t)
$$

入力ブランチ側は線形変換と非線形関数$phi.alt$を用いた変形を行う。

これらを結合して線形変換を行い、最終的な出力$bold(y)_t$を得る。結合の方法は単純に連結するだけである。
$$
bold(y)_t = bold(W)_"out" "concat"(hat(bold(y))_t^((1)), hat(bold(y))_t^((2)), ..., hat(bold(y))_t^((H)))
$$

```typst {render=svg caption="各ヘッドの出力から最終出力までの経路"}
#cetz.canvas(length: 1cm, {
  import cetz.draw: *

  let hw = 0.95
  let h  = 0.7
  let r  = 0.2
  let ys = -4.3     // 乗算の高さ

  let blk(cx, yt, label, sc, fc, half) = {
    rounded-block((cx - half, yt), (cx + half, yt - h), none,
      block-style: bs(sc, fc), center-content: lbl(label))
  }
  let heads = (0.0, 3.0, 6.0)
  let names = ($bold(y)_t^((1))$, $bold(y)_t^((2))$, $bold(y)_t^((H))$)

  // 各ヘッドの出力から RMSNorm まで
  for i in range(3) {
    let x = heads.at(i)
    content((x, -6.6), text(size: 9pt, names.at(i)))
    line((x, -6.3), (x, ys - r), ..arw)
    blk(x, -4.9, [RMSNorm], c-teal, c-teal-l, hw)
  }
  content((4.5, -5.25), text(size: 11pt, $dots.c$))

  // ゲートの供給。母線を引いてから乗算アイコンを白抜きで重ねる
  blk(9.8, -4.0, [$phi.alt(bold(W)_"gate" bold(x)_t)$], c-orange, c-orange-l, 1.5)
  line((8.3, ys), (0.0, ys), stroke: black + 0.9pt)
  for x in heads {
    circle((x, ys), radius: r, stroke: black + 0.9pt, fill: white)
    circle((x, ys), radius: 0.055, stroke: none, fill: black)
  }
  for x in heads { line((x + 0.5, ys), (x + r, ys), ..arw) }

  // 連結して線形変換
  for x in heads { line((x, ys + r), (x, -3.6), ..arw) }
  content((7.0, -3.95), text(size: 7.5pt, $hat(bold(y))_t^((h))$))
  rounded-block((-1.2, -2.9), (7.2, -3.6), none,
    block-style: bs(c-gray, c-gray-l), center-content: lbl([Concat]))
  line((3.0, -2.9), (3.0, -2.3), ..arw)
  trapezoid-block((3.0 - hw, -1.6), (3.0 + hw, -1.6 - h), none,
    side: "top", shrink: 30%, corner-radius: 0.12,
    block-style: (fill: c-purple-l, stroke: c-purple + 1pt),
    center-content: lbl([$bold(W)_"out"$]))
  line((3.0, -1.6), (3.0, -0.9), ..arw)
  content((3.0, -0.6), text(size: 9pt, $bold(y)_t$))
})
```
